CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# A new firmware image must confirm itself or the bootloader goes back to the old one (see mark_firmware_good).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FATFS_LFN_HEAP=y

# BLE-only Bluedroid server, matching the ESP-IDF 5.5 ESP32-S3 example.
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LV_MEM_SIZE=32768

# Light sleep: the processor sleeps between events, and Wi-Fi and Bluetooth sleep between theirs. Bluetooth keeps
# the main crystal as its slow clock (this board has no 32 kHz crystal) and powers it during sleep.
CONFIG_PM_ENABLE=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_PM_PROFILING=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# Internal RAM is tight while a sync runs (Wi-Fi, Bluetooth and the card at once): fewer static Wi-Fi receive buffers
# (the board mostly sends) and the receive path in flash instead of IRAM, which gives back about 20 KB.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
